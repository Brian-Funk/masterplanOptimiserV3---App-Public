# Database Configuration
# Desktop: SQLite (local file)
DATABASE_URL=sqlite:///./data/masterplan.db

# Web: PostgreSQL (uncomment when deploying to web)
# DATABASE_URL=postgresql://user:password@localhost:5432/masterplan

# API Configuration
API_HOST=127.0.0.1
API_PORT=8000

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Environment
ENVIRONMENT=desktop

# Optimizer Service
OPTIMIZER_URL=http://127.0.0.1:8765
