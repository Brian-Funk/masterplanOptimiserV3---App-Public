# Web Deployment Environment
# Read-only mode with cloud databases

ENVIRONMENT=web

# Auth Database - Cloud PostgreSQL for users
AUTH_DATABASE_URL=postgresql://user:password@your-cloud-server.com/masterplan_auth

# Data Database - Cloud PostgreSQL for published events/schedules
DATA_DATABASE_URL=postgresql://user:password@your-cloud-server.com/masterplan_data

# Cloud API URL (same as this instance for web)
CLOUD_API_URL=https://api.yourdomain.com

# Legacy (for backward compatibility)
DATABASE_URL=postgresql://user:password@localhost/masterplan

API_HOST=0.0.0.0
API_PORT=8000

SECRET_KEY=change-this-to-a-secure-random-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

CORS_ORIGINS=["https://yourdomain.com"]

# Optimizer not available in web mode
# OPTIMIZER_URL=http://localhost:8765
