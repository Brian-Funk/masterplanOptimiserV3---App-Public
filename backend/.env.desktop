# Desktop Application Environment
# Full access mode with local SQLite database

ENVIRONMENT=desktop

# Database - Local SQLite for all data
DATABASE_URL=sqlite:///./data/masterplan.db

# API
API_HOST=127.0.0.1
API_PORT=8000

CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

OPTIMIZER_URL=http://127.0.0.1:8000/compute

# Google OAuth2 credentials are stored in the database (Settings → Google OAuth).
# Create credentials at https://console.cloud.google.com/apis/credentials
# Application type: Web application
# Authorized redirect URI: http://localhost:8000/api/v1/google/oauth2callback
